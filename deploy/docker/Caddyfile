# HUE_SITE = tên miền thật hoặc <IP>.sslip.io (Caddy tự xin chứng chỉ Let's Encrypt); ":80" = http để thử ở máy (không TLS).
{$HUE_SITE}

# Trần cỡ yêu cầu ở cửa vào (bảng rủi ro 22/11, điểm còn mở): thân lớn nhất app nhận là ảnh hỏi 10 MB (`settings.yaml` `anh.max_bytes`) ⇒ 12 MB cho
# cả phần bọc của biểu mẫu; lớn hơn thì Caddy trả 413, không tới app.
request_body {
	max_size 12MB
}

# Security headers ở cửa vào: KHÔNG đặt Content-Security-Policy ở đây vì FastAPI tự gắn `FRONTEND_CSP` / `FRONTEND_CSP_BAN_DO` trên `/` và `/static/index.html`.
# Strict-Transport-Security chỉ bật khi kết nối là HTTPS (an toàn khi test HTTP `:80`, không làm trình duyệt kẹt HSTS trên môi trường thử).
header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
}
@https protocol https
header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

# Cache-Control cho tài nguyên tĩnh của Vite (`frontend/vite.config.js` đặt `base: "/static/"`):
# - `/static/assets/*`: file JS/CSS có hash nội dung ⇒ cache 1 năm, immutable.
# - `/static/anh/*`, `/static/hoa_tiet/*`, `/static/favicon.svg`: ảnh tĩnh của cổng/khám phá ⇒ cache 1 ngày.
@static_assets path /static/assets/*
header @static_assets Cache-Control "public, max-age=31536000, immutable"
@static_media path /static/anh/* /static/hoa_tiet/* /static/favicon.svg
header @static_media Cache-Control "public, max-age=86400"

# Khóa tạm bằng mật khẩu khi demo cho giảng viên (mặc định tắt). Bật nhanh:
#   1. Tạo băm mật khẩu: docker run --rm caddy:2.11.7 caddy hash-password --plaintext '<mật_khẩu>'
#   2. Bỏ dấu # ở khối `basic_auth` dưới, thay chuỗi băm `$2a$...`, rồi `docker compose --env-file hue.env up -d --force-recreate caddy`.
# basic_auth {
# 	demo $2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT
# }

# Nén trang / JS / CSS; KHÔNG nén luồng trả lời (/api/chat/stream) để chữ đi ra ngay, không bị gom.
# Lưu ý khi bật `so_tay` hoặc `ho_so_chu_de` ở bản deploy (hiện `dong_goi.sh` ép tắt cả hai):
# thêm `/api/so_tay` và `/api/ho_so` vào dòng `@nen not path` dưới rồi chạy `dc up -d --force-recreate caddy`, kẻo tiến độ từng mục bị gom lại.
@nen not path /api/chat/stream
encode @nen gzip
reverse_proxy app:8000 {
	flush_interval -1
}
