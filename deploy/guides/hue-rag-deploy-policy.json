{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ThungGoi",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::hue-rag-artifacts-*",
        "arn:aws:s3:::hue-rag-artifacts-*/*"
      ]
    },
    {
      "Sid": "VaiGanMay",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile",
        "iam:ListInstanceProfileTags"
      ],
      "Resource": [
        "arn:aws:iam::*:role/hue-rag-*",
        "arn:aws:iam::*:instance-profile/hue-rag-*"
      ]
    },
    {
      "Sid": "ChiGanChinhSachSessionManagerVaoVai",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/hue-rag-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "GiaoVaiChoMayEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/hue-rag-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ChuDeEmailCanhBao",
      "Effect": "Allow",
      "Action": "sns:*",
      "Resource": "arn:aws:sns:ap-southeast-1:*:hue-rag-*"
    },
    {
      "Sid": "DangKyEmailVaoChuDe",
      "Effect": "Allow",
      "Action": [
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:Unsubscribe",
        "sns:ListSubscriptions",
        "sns:ListTopics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NganSach",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::*:budget/hue-rag-*"
    },
    {
      "Sid": "MayChuMangDiaChiIP",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "BaoDongMayHong",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:SetAlarmState",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudwatch:ap-southeast-1:*:alarm:hue-rag-*"
    },
    {
      "Sid": "MoPhienVaoMayMangTheDuAn",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:ap-southeast-1:*:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "hue-rag"
        }
      }
    },
    {
      "Sid": "TaiLieuPhienMacDinh",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ssm:ap-southeast-1:*:document/SSM-SessionManagerRunShell"
    },
    {
      "Sid": "DongVaNoiLaiPhienCuaChinhMinh",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "arn:aws:ssm:*:*:session/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/aws:ssmmessages:session-id": "${aws:userid}"
        }
      }
    },
    {
      "Sid": "XemTrangThai",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeInstanceProperties",
        "cloudwatch:DescribeAlarms",
        "tag:GetResources"
      ],
      "Resource": "*"
    }
  ]
}
