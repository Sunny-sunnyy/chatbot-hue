# Chép file này thành `terraform.tfvars` (file đó KHÔNG vào git) rồi điền hai dòng bắt buộc.
# Lấy hai giá trị từ tầng nền:
#   cd ../1_nen_tang && terraform output -raw instance_profile_name && echo && terraform output -raw artifact_bucket_name && echo

instance_profile_name = "DIEN-TEN-HO-SO-GAN-MAY-CUA-TANG-NEN"
artifact_bucket_name  = "DIEN-TEN-THUNG-CUA-TANG-NEN"

# Tuỳ chọn — bỏ dấu # và sửa khi muốn khác mặc định (mặc định ghi ở variables.tf):
# aws_region      = "ap-southeast-1"
# project_name    = "hue-rag"
# instance_type   = "t3a.medium"
# root_volume_gb  = 40
# swap_gb         = 2
# alert_topic_arn = ""   # ARN chủ đề email cảnh báo của tầng nền ⇒ có thêm một báo động "máy không qua kiểm tra trạng thái"
