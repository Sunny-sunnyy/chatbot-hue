#!/usr/bin/env bash
# Hook pre-commit của hue_rag — chạy cho MỌI agent (Claude Code, Codex, AGY) và cho người, vì nằm ở tầng git.
# Vì sao: repo `chatbot-hue` là PUBLIC; lộ dữ liệu riêng / secret / chi tiết dự án khác lên lịch sử git thì không
# lấy lại được (Session_Prompt.md §5; sổ session_prompt/SO_CAI_TIEN_CACH_LAM.md). Chặn khi:
#   1. stage file thuộc vùng private: data/, knowledge-base-hue/, "gửi chatgpt/", .aws/, .env*;
#   2. dòng THÊM MỚI có dạng secret (key OpenAI/OpenRouter, AWS access key, private key);
#   3. dòng THÊM MỚI hoặc tên file nhắc tên dự án khác của User (ghi chú về dự án đó để ở data/ — Session_Prompt.md §5);
#   4. dòng THÊM MỚI trùng >= 40 ký tự với Golden / kho / câu kín (`.githooks/overlap_scan.py`; chỉ khi máy có kho — clone public bỏ qua).
# Bật một lần cho mỗi bản clone: git config core.hooksPath .githooks
# Chặn nhầm: dừng, báo User; chỉ bỏ qua bằng `git commit --no-verify` khi User duyệt đúng commit đó.
set -u

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')

private=$(printf '%s\n' "$staged" | grep -E '^(data/|knowledge-base-hue/|gửi chatgpt/|\.aws/)|(^|/)\.env($|\.)' || true)
if [ -n "$private" ]; then
  echo "pre-commit: CHẶN — file thuộc vùng private (không commit lên repo public):" >&2
  printf '%s\n' "$private" | sed 's/^/  /' >&2
  fail=1
fi

# Chỉ xét dòng thêm mới trong thân hunk (sau "@@"), để dòng tiêu đề "+++ b/…" không bị tính mà dòng nội dung bắt
# đầu bằng "++" vẫn được kiểm (review 25/10 F1). File nhị phân không có hunk nên tự bỏ qua.
# Mẫu viết sao cho không tự khớp chính file này.
added=$(git diff --cached -U0 --no-color --diff-filter=ACMR -- . \
  | awk '/^diff --git /{h=0; next} /^@@/{h=1; next} h && /^\+/' || true)

secret=$(printf '%s\n' "$added" | grep -nE 'sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|BEGIN[A-Z ]*PRIVATE KEY' || true)
if [ -n "$secret" ]; then
  echo "pre-commit: CHẶN — dòng thêm mới có dạng secret (không in nội dung):" >&2
  printf '%s\n' "$secret" | cut -d: -f1 | sed 's/^/  dòng diff #/' >&2
  fail=1
fi

other=$( { printf '%s\n' "$staged" | sed 's/^/[tên file] /'; printf '%s\n' "$added"; } | grep -iE 'm[e]kong' || true)
if [ -n "$other" ]; then
  echo "pre-commit: CHẶN — tên file / dòng thêm mới nhắc tên dự án khác của User; chi tiết dự án đó để ở data/ (private):" >&2
  printf '%s\n' "$other" | cut -c1-160 | sed 's/^/  /' >&2
  fail=1
fi

# Quét trùng chạy bằng .venv của working tree chính (git-common-dir) để commit từ worktree /tmp không làm uv tạo .venv lạ.
# Hai lần quét tay nối "; git commit" vẫn commit dù quét báo trùng (sổ cải tiến S23, S28) ⇒ rào ở đây (W16).
# Kho kiểm ở working tree chính: worktree /tmp thường không có symlink kho, không được lặng lẽ bỏ qua (review C 26/10 M-1).
main_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
if [ -f "$main_root/knowledge-base-hue/evaluation/golden_full_corpus.jsonl" ]; then
  uv run --quiet --project "$main_root" python .githooks/overlap_scan.py --staged >&2
  scan=$?
  if [ "$scan" -eq 3 ]; then
    echo "pre-commit: CHẶN — dòng thêm mới trùng >= 40 ký tự với Golden / kho / câu kín (số dòng + nhãn ở trên; nội dung không in)." >&2
    fail=1
  elif [ "$scan" -ne 0 ]; then
    echo "pre-commit: CHẶN — quét trùng Golden / kho LỖI (mã $scan: thiếu uv / Python lỗi — xem dòng trên), chưa kiểm được." >&2
    fail=1
  fi
fi

# Giờ ước kiểu "giờ:phút-chục + chữ x" lọt vào file ~7 lần trong phiên 28/10 dù WORKFLOW.md §6 đã có luật (sổ cải tiến S45, W30) ⇒ cảnh báo, không chặn:
# người commit sửa bằng giờ `date` rồi stage lại. Chỉ xét dòng thêm mới, nên dòng lịch sử cũ không bị nhắc.
approx=$(printf '%s\n' "$added" | grep -nE '(^|[^0-9])[0-2][0-9]:[0-5]x($|[^0-9A-Za-z])' || true)
if [ -n "$approx" ]; then
  echo "pre-commit: CẢNH BÁO (không chặn) — dòng thêm mới có giờ ước dạng HH:Mx; ghi giờ bằng \`date\` (WORKFLOW.md §6):" >&2
  printf '%s\n' "$approx" | cut -c1-160 | sed 's/^/  dòng diff #/' >&2
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: sửa rồi stage lại. Chặn nhầm thì báo User (bỏ qua chỉ khi User duyệt: git commit --no-verify)." >&2
fi
exit "$fail"
