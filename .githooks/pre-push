#!/usr/bin/env bash
# Hook pre-push của hue_rag — lớp thứ hai sau pre-commit, cho MỌI agent và người (tầng git).
# Vì sao (01/11, rủi ro CA1 — `report_agent/2026-10-31_streaming_spec/c106_bao_mat_dong_goi.md`): agent được tự `git push` lên repo
# PUBLIC; commit tạo bằng `--no-verify`, từ máy chưa bật hook, hay bằng công cụ khác thì pre-commit không chạy. Hook này kiểm lại
# MỌI commit sắp đẩy (3 phép rẻ của pre-commit: đường dẫn private · dạng secret · tên dự án khác). Quét trùng Golden / kho chỉ ở pre-commit.
# Bật cùng pre-commit: git config core.hooksPath .githooks. Chặn nhầm: báo User; bỏ qua chỉ khi User duyệt (git push --no-verify).
set -u
zero=0000000000000000000000000000000000000000
fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                       # xoá nhánh: không có gì để quét
  if [ "$remote_sha" = "$zero" ]; then
    range=$(git rev-list "$local_sha" --not --remotes)          # nhánh mới: chỉ commit chưa có trên remote
  else
    range=$(git rev-list "$remote_sha..$local_sha")
  fi
  for c in $range; do
    files=$(git diff-tree --no-commit-id --name-only -r --diff-filter=ACMR "$c")
    added=$(git show --format= -U0 --no-color --diff-filter=ACMR "$c" | awk '/^diff --git /{h=0; next} /^@@/{h=1; next} h && /^\+/')
    short=$(git rev-parse --short "$c")
    if printf '%s\n' "$files" | grep -qE '^(data/|knowledge-base-hue/|gửi chatgpt/|\.aws/)|(^|/)\.env($|\.)'; then
      echo "pre-push: CHẶN — commit $short có file thuộc vùng private." >&2; fail=1
    fi
    if printf '%s\n' "$added" | grep -qE 'sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|BEGIN[A-Z ]*PRIVATE KEY'; then
      echo "pre-push: CHẶN — commit $short có dòng thêm mới dạng secret (không in nội dung)." >&2; fail=1
    fi
    if { printf '%s\n' "$files"; printf '%s\n' "$added"; } | grep -qiE 'm[e]kong'; then
      echo "pre-push: CHẶN — commit $short nhắc tên dự án khác của User (để ở data/)." >&2; fail=1
    fi
  done
done
[ "$fail" -eq 0 ] || echo "pre-push: sửa lịch sử commit chưa đẩy rồi push lại. Chặn nhầm thì báo User." >&2
exit "$fail"
